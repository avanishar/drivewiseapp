# Git LFS tracking for large binary/data files
*.pdf filter=lfs diff=lfs merge=lfs -text
*.json filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text

# Exclude samples/ from LFS — these are small demo PDFs committed directly
# so they can be downloaded via raw.githubusercontent.com in Colab
samples/*.pdf !filter !diff !merge -text
brochures/*.pdf filter=lfs diff=lfs merge=lfs -text
index/*.json filter=lfs diff=lfs merge=lfs -text
