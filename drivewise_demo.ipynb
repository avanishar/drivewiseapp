   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "chat_history = []\n",
    "CAR_MAP = get_car_map()\n",
    "brand_options = sorted(CAR_MAP.keys())\n",
    "\n",
    "# ── Widgets ────────────────────────────────────────────────────────────────────\n",
    "brand_dropdown = widgets.Dropdown(\n",
    "    options=brand_options,\n",
    "    value=brand_options[0] if brand_options else None,\n",
    "    description='🏷️ Brand:',\n",
    "    style={'description_width': '70px'},\n",
    "    layout=widgets.Layout(width='230px')\n",
    ")\n",
    "\n",
    "model_dropdown = widgets.Dropdown(\n",
    "    options=CAR_MAP.get(brand_options[0], []) if brand_options else [],\n",
    "    description='🚗 Model:',\n",
    "    style={'description_width': '70px'},\n",
    "    layout=widgets.Layout(width='230px')\n",
    ")\n",
    "\n",
    "query_input = widgets.Textarea(\n",
    "    placeholder='Type your question here...\\nExamples:\\n• What safety features does it have?\\n• What is the mileage?\\n• What are the engine specs?\\n• What is the boot space?',\n",
    "    layout=widgets.Layout(width='100%', height='90px')\n",
    ")\n",
    "\n",
    "ask_btn = widgets.Button(\n",
    "    description=' Ask DriveWise',\n",
    "    button_style='primary', icon='search',\n",
    "    layout=widgets.Layout(width='185px', height='40px')\n",
    ")\n",
    "clear_btn = widgets.Button(\n",
    "    description=' Clear Chat',\n",
    "    button_style='warning', icon='trash',\n",
    "    layout=widgets.Layout(width='140px', height='40px')\n",
    ")\n",
    "\n",
    "status_lbl  = widgets.HTML(value='<span style=\"color:#64748b; font-size:0.9rem;\">Ready! Select a car and type your question.</span>')\n",
    "chat_out    = widgets.Output(layout=widgets.Layout(\n",
    "    border='1px solid #e2e8f0', border_radius='10px', padding='14px',\n",
    "    min_height='180px', max_height='550px', overflow_y='auto'\n",
    "))\n",
    "\n",
    "def on_brand_change(change):\n",
    "    CAR_MAP2 = get_car_map()\n",
    "    model_dropdown.options = CAR_MAP2.get(change['new'], [])\n",
    "\n",
    "brand_dropdown.observe(on_brand_change, names='value')\n",
    "\n",
    "def render_chat():\n",
    "    with chat_out:\n",
    "        clear_output(wait=True)\n",
    "        if not chat_history:\n",
    "            display(HTML(\"\"\"\n",
    "            <div style=\"text-align:center; padding:36px; color:#94a3b8;\">\n",
    "              <div style=\"font-size:3rem;\">🚗</div>\n",
    "              <div style=\"font-size:1.05rem; margin-top:8px; font-weight:600;\">Ask anything about your car!</div>\n",
    "              <div style=\"font-size:0.82rem; margin-top:6px; color:#cbd5e1;\">\n",
    "                mileage · safety features · engine specs · dimensions · infotainment · comfort\n",
    "              </div>\n",
    "            </div>\n",
    "            \"\"\"))\n",
    "            return\n",
    "        for item in chat_history:\n",
    "            # User bubble (right)\n",
    "            display(HTML(f\"\"\"\n",
    "            <div style=\"margin:10px 0; display:flex; justify-content:flex-end;\">\n",
    "              <div style=\"background:#eff6ff; border:1px solid #bfdbfe; border-radius:16px 16px 4px 16px;\n",
    "                          padding:10px 14px; max-width:80%; font-size:0.92rem; color:#1e3a5f;\">\n",
    "                <b>👤 You</b> <span style=\"font-size:0.75rem;color:#94a3b8;\">· {item['car']}</span><br>\n",
    "                {item['query']}\n",
    "              </div>\n",
    "            </div>\n",
    "            \"\"\"))\n",
    "            # Answer bubble (left)\n",
    "            answer_html = item['answer'].replace('\\n', '<br>')\n",
    "            display(HTML(f\"\"\"\n",
    "            <div style=\"margin:6px 0 14px 0;\">\n",
    "              <div style=\"background:#fff; border:1px solid #e2e8f0; border-left:4px solid #3b82f6;\n",
    "                          border-radius:4px 14px 14px 14px; padding:12px 16px; max-width:95%;\n",
    "                          font-size:0.92rem; color:#1e293b; box-shadow:0 2px 6px rgba(0,0,0,0.05);\">\n",
    "                <b>🤖 Drive Wise</b>\n",
    "                <span style=\"font-size:0.75rem; color:#64748b;\">· {item['time']}s</span><br><br>\n",
    "                {answer_html}\n",
    "              </div>\n",
    "            </div>\n",
    "            \"\"\"))\n",
    "            # Source tags\n",
    "            if item.get('sources'):\n",
    "                tags = \"\".join([\n",
    "                    f\"<span style='display:inline-block;background:#f0fdf4;color:#166534;\"\n",
    "                    f\"font-size:0.73rem;padding:2px 8px;border-radius:20px;margin:2px;\"\n",
    "                    f\"border:1px solid #bbf7d0;'>[{i+1}] Pg {s['page']} · {s['section']}</span>\"\n",
    "                    for i, s in enumerate(item['sources'])\n",
    "                ])\n",
    "                display(HTML(f'<div style=\"margin:-6px 0 10px 12px;\">\U0001f4da {tags}</div>'))\n",
    "            display(HTML(\"<hr style='border:none;border-top:1px solid #f1f5f9;margin:4px 0;'>\"))\n",
    "\n",
    "def on_ask(b):\n",
    "    query = query_input.value.strip()\n",
    "    if not query:\n",
    "        status_lbl.value = '<span style=\"color:#ef4444;\">⚠️ Please type a question first!</span>'\n",
    "        return\n",
    "    if not brand_dropdown.value or not model_dropdown.value:\n",
    "        status_lbl.value = '<span style=\"color:#ef4444;\">⚠️ No car indexed yet. Run Step 3 first!</span>'\n",
    "        return\n",
    "\n",
    "    brand = brand_dropdown.value\n",
    "    model = model_dropdown.value\n",
    "    ask_btn.disabled = clear_btn.disabled = True\n",
    "    ask_btn.description = ' Thinking...'\n",
    "    status_lbl.value = f'<span style=\"color:#3b82f6;\">⏳ Searching brochure for {brand} {model}...</span>'\n",
    "    query_input.value = ''\n",
    "\n",
    "    t0 = time.time()\n",
    "    answer, sources = generate_answer(query, brand, model)\n",
    "    elapsed = round(time.time() - t0, 2)\n",
    "\n",
    "    chat_history.append({'query': query, 'answer': answer, 'sources': sources,\n",
    "                         'car': f'{brand} {model}', 'time': elapsed})\n",
    "    render_chat()\n",
    "    status_lbl.value = f'<span style=\"color:#10b981;\">✅ Done in {elapsed}s · used {len(sources)} chunk(s)</span>'\n",
    "    ask_btn.disabled = clear_btn.disabled = False\n",
    "    ask_btn.description = ' Ask DriveWise'\n",
    "\n",
    "def on_clear(b):\n",
    "    chat_history.clear()\n",
    "    render_chat()\n",
    "    status_lbl.value = '<span style=\"color:#64748b;\">🗑️ Chat cleared.</span>'\n",
    "\n",
    "ask_btn.on_click(on_ask)\n",
    "clear_btn.on_click(on_clear)\n",
    "\n",
    "# ── Layout ──────────────────────────────────────────────────────────────────────\n",
    "header_html = widgets.HTML(\"\"\"\n",
    "<div style=\"background:linear-gradient(135deg,#1d4ed8,#3b82f6);color:white;\n",
    "             padding:14px 20px;border-radius:12px 12px 0 0;\">\n",
    "  <span style=\"font-size:1.25rem;font-weight:700;\">🚗 Drive Wise — Chat</span>\n",
    "  <span style=\"font-size:0.82rem;opacity:0.8;margin-left:10px;\">Grounded answers from car brochures</span>\n",
    "</div>\n",
    "\"\"\")\n",
    "\n",
    "render_chat()\n",
    "display(widgets.VBox([\n",
    "    header_html,\n",
    "    widgets.HBox([brand_dropdown, model_dropdown], layout=widgets.Layout(gap='10px', margin='8px 0')),\n",
    "    widgets.HTML('<div style=\"font-weight:600;color:#334155;margin:4px 0 2px 0;\">💬 Your Question:</div>'),\n",
    "    query_input,\n",
    "    widgets.HBox([ask_btn, clear_btn, status_lbl], layout=widgets.Layout(gap='10px', align_items='center', margin='6px 0')),\n",
    "    chat_out\n",
    "], layout=widgets.Layout(border='1px solid #e2e8f0', border_radius='12px', padding='16px', width='100%')))"
   ]
  },
