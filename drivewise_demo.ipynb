    "            '<b>📤 Upload Your Own Car Brochure PDF</b><br>'\n",
    "            '<span style=\"font-size:0.85rem; color:#475569;\">Name it <code>Brand_Model.pdf</code> '\n",
    "            '(e.g. <code>Toyota_Fortuner.pdf</code>). It will be indexed and available in the chat.</span></div>'),\n",
    "        upload_btn,\n",
    "        upload_status,\n",
    "        upload_output\n",
    "    ]))\n",
    "else:\n",
    "    # Local Jupyter — use ipywidgets FileUpload\n",
    "    file_upload = widgets.FileUpload(accept='.pdf', multiple=False,\n",
    "        description='Upload PDF',\n",
    "        layout=widgets.Layout(width='220px'))\n",
    "    process_btn = widgets.Button(description=' Index PDF',\n",
    "        button_style='info', icon='cog',\n",
